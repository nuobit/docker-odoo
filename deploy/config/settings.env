# Instance-level configuration
# Bind-mounted into the container at /opt/odoo/config/settings.env
# Sourced at runtime, overriding defaults from defaults.env.
# Changes take effect on next script execution (no rebuild needed).

# PostgreSQL admin password for db create/drop/reset/createuser/dropuser.
# If unset, will be prompted interactively on each operation.
# No quotes needed for simple alphanumeric: DB_PGUSER_PASSWORD=abc123
# Double quotes for spaces or #:          DB_PGUSER_PASSWORD="my pass"
# Single quotes for $ ! or backticks:     DB_PGUSER_PASSWORD='pa$$w!rd'
#DB_PGUSER_PASSWORD=

# Confirmation level for destructive operations (default: all).
# Applies to all scripts (db drop/reset, snapshot remove/restore, etc.).
# Values: all (confirm everything), deletions (only rm -rf), none (skip all).
# Can also be set per command with -f/--force (equivalent to none).
#CONFIRM_LEVEL=deletions
