# Odoo Docker Image Configuration
# Default values - can be overridden by environment variables
PYTHON_BIN=${PYTHON_BIN:-/usr/bin/python}

SRC_DIR=${SRC_DIR:-${HOME}/src}
SRC_REPOS_FILENAME=${SRC_REPOS_FILENAME:-repos.yaml}

ODOO_DIR=${ODOO_DIR:-${SRC_DIR}/odoo}
ODOO_BIN=${ODOO_BIN:-${ODOO_DIR}/odoo-bin}
ODOO_CONF_DIR=${ODOO_CONF_DIR:-/etc/odoo}
ODOO_CONF=${ODOO_CONF:-${ODOO_CONF_DIR}/odoo.conf}
ODOO_DATA_DIR=${ODOO_DATA_DIR:-/var/lib/odoo}
#ODOO_SHELL_PORT=${ODOO_SHELL_PORT:-58315}

DIST_CONFIG_DIR=${DIST_CONFIG_DIR:-${HOME}/config}
DIST_CONFIG=${DIST_CONFIG:-${DIST_CONFIG_DIR}/paths.env}
DIST_CONFIG_CONSTRAINTS=${DIST_CONFIG_CONSTRAINTS:-${DIST_CONFIG_DIR}/constraints.txt}

DIST_SCRIPTS_DIR=${DIST_SCRIPTS_DIR:-${HOME}/scripts}
DIST_BIN_DIR=${DIST_BIN_DIR:-${DIST_SCRIPTS_DIR}/bin}
DIST_ASSETS_DIR=${DIST_ASSETS_DIR:-${DIST_SCRIPTS_DIR}/assets}
DIST_LIB_DIR=${DIST_LIB_DIR:-${DIST_SCRIPTS_DIR}/lib}
