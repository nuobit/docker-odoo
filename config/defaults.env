# Odoo Docker Image Configuration
# Default values - can be overridden by instance settings.env (bind-mounted at runtime)
PYTHON_BIN=/usr/bin/python

# Dist directory (baked into image)
DIST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST_CONSTRAINTS=${DIST_DIR}/constraints.txt

# Instance configuration (bind-mounted at runtime)
INSTANCE_DIR=${HOME}/config
INSTANCE_SETTINGS=${INSTANCE_DIR}/settings.env
INSTANCE_REPOS=${INSTANCE_DIR}/repos.yaml

# Scripts
SCRIPTS_DIR=${HOME}/scripts
BIN_DIR=${SCRIPTS_DIR}/bin
ASSETS_DIR=${SCRIPTS_DIR}/assets
LIB_DIR=${SCRIPTS_DIR}/lib

# Source code
SRC_DIR=${HOME}/src
#SRC_REPOS_ORDER="vendor,oca,odoo"
SRC_ODOO_REPO_DIR=odoo

# Odoo
ODOO_DIR=${SRC_DIR}/odoo
ODOO_BIN=${ODOO_DIR}/odoo-bin
ODOO_CONF=${INSTANCE_DIR}/odoo.conf
ODOO_DATA_DIR=/var/lib/odoo
# Port for 'shell' script to avoid collision with running Odoo server.
# Use a port in the range 49152-65535 (private/dynamic ports per IANA).
# Ports 0-1023 are system/well-known, 1024-49151 are registered/user.
ODOO_SHELL_PORT=58315

# Database configuration
DB_PGDB=postgres
DB_PGUSER=postgres
# Set DB_FORCE=true to skip database name confirmation on drop/reset
DB_FORCE=false

# Source instance-level overrides (optional, bind-mounted at runtime)
if [[ -f "${INSTANCE_SETTINGS}" ]]; then
  source "${INSTANCE_SETTINGS}"
fi
